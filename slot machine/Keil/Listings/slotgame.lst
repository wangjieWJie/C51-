 114          uint wj_rand()  //生成随机数
 115          {
 116   1          uint random_nm;
 117   1          uchar low, high;
 118   1                 
 119   1          high = TH1;  //利用定时器的不断变换的高低八位来随机生成随机数
 120   1          low = TL1;    //定时器低八位
 121   1          srand(low<<8 | high);    //创意修改，让高位成为低位，低位成为高位，使得没次调用时，srand相差更大
 122   1          random_nm = rand() % 3;  //生成0-2之间的随机数
 123   1       
 124   1          return random_nm;   //返回生成的随机数
 125   1      }
