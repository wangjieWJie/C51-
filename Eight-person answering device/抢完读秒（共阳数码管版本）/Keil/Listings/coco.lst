 193          void int_timer0()   // 初始化定时器0为模式2（自动重载）
 194          {
 195   1          TMOD &= 0XF0;   // 清零定时器0的模式位（保留定时器1的配置）
 196   1          TMOD |= 0X02;   // 设置定时器0为模式2（8位自动重载）
 197   1          TH0 = 0xA4;     // 自动重载值（100μs定时初值，11.0592MHz）
 198   1          TL0 = 0xA4;     // 首次启动时的初值（必须与TH0相同）
 199   1          ET0 = 1;        // 允许定时器0中断
 200   1          TR0 = 1;        // 启动定时器0
 201   1          EA = 1;         // 开启全局中断
 202   1      }
