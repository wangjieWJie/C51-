 213          void int_timer0()   // 初始化定时器0为模式2（自动重载）
 214          {
 215   1          TMOD &= 0XF0;   // 清零定时器0的模式位（保留定时器1的配置）
 216   1          TMOD |= 0X02;   // 设置定时器0为模式2（8位自动重载）
 217   1          TH0 = 0xA4;     // 自动重载值（100μs定时初值，11.0592MHz）
 218   1          TL0 = 0xA4;     // 首次启动时的初值（必须与TH0相同）
 219   1          ET0 = 1;        // 允许定时器0中断
 220   1          TR0 = 1;        // 启动定时器0
 221   1          EA = 1;         // 开启全局中断
 222   1      }
